# Supabase project for sign-in. Copy this file to .env and put your real values there. Never commit .env.
# Find them in the Supabase dashboard: "Connect" button, or Project Settings > API Keys.
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
